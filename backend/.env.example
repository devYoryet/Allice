# ======================================================
# Base de datos PostgreSQL (Neon - tier gratuito)
# Crear cuenta en: https://neon.tech
# En tu proyecto Neon copias la "Connection string" y la "Direct URL"
# ======================================================
DATABASE_URL="postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require"

# ======================================================
# JWT - usa una clave larga y aleatoria
# Genera una con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ======================================================
JWT_SECRET="cambiar-por-clave-secreta-larga-y-aleatoria"
JWT_EXPIRES_IN="7d"

# ======================================================
# Servidor
# ======================================================
PORT=3001
NODE_ENV=development

# ======================================================
# Frontend URL (para CORS en producción)
# Ej: https://allice.vercel.app
# ======================================================
FRONTEND_URL="http://localhost:5173"
