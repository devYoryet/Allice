generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            Int      @id @default(autoincrement())
  name          String
  email         String   @unique
  password_hash String
  role          String   @default("vendedor") // admin | vendedor | produccion
  created_at    DateTime @default(now())

  businesses        Business[]
  visit_logs        VisitLog[]
  orders            Order[]
  lotes             LoteProduccion[]
  cierres           CierreMes[]
  whatsapp_contacts WhatsAppContact[]
}

model Business {
  id            Int      @id @default(autoincrement())
  nombre        String
  direccion     String
  persona_cargo String?
  telefono      String
  lat           Float?
  lng           Float?
  estado_visita String   @default("no_visitado") // no_visitado | visitado_sin_venta | cliente_activo
  creado_por    Int
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  // Soft-delete: solo supermaster puede eliminar
  deleted_at        DateTime? // null = activo
  deleted_by_email  String? // email de quien eliminó
  kilos_al_eliminar Float? // kg vendidos al momento de eliminar

  user              User              @relation(fields: [creado_por], references: [id])
  visit_logs        VisitLog[]
  orders            Order[]
  whatsapp_contacts WhatsAppContact[]
}

model VisitLog {
  id          Int      @id @default(autoincrement())
  business_id Int
  user_id     Int
  fecha       DateTime @default(now())
  tipo        String // visita_sin_venta | visita_con_venta
  comentario  String?
  created_at  DateTime @default(now())

  business Business @relation(fields: [business_id], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [user_id], references: [id])
}

model Order {
  id             Int      @id @default(autoincrement())
  business_id    Int
  user_id        Int
  fecha          DateTime @default(now())
  kilos          Float
  precio_kg      Float    @default(400) // precio por kilo en CLP
  con_iva        Boolean  @default(false) // true = facturado con IVA 19%
  monto_neto     Float? // kilos × precio_kg
  monto_total    Float? // monto_neto × 1.19 si con_iva, else monto_neto
  estado_pedido  String   @default("pendiente") // pendiente | entregado
  estado_pago    String   @default("pendiente") // pendiente | pagado
  estado_factura String   @default("sin_factura") // sin_factura | facturado
  origen         String   @default("presencial") // presencial | whatsapp
  comentario     String?
  cierre_id      Int? // null = período actual abierto; asignado al hacer cierre de mes
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  business Business   @relation(fields: [business_id], references: [id], onDelete: Cascade)
  user     User       @relation(fields: [user_id], references: [id])
  cierre   CierreMes? @relation(fields: [cierre_id], references: [id])

  @@index([cierre_id])
  @@index([origen])
}

// Cierre mensual: se realiza el día 9 de cada mes (ej: 9 abril, 9 mayo, ...)
model CierreMes {
  id               Int      @id @default(autoincrement())
  periodo          String // ej: "Abril 2026"
  fecha_cierre     DateTime @default(now())
  total_kilos      Float
  total_ventas     Float // suma monto_total de todas las órdenes cerradas
  total_cobrado    Float // lo que ya estaba pagado al momento del cierre
  ordenes_cerradas Int
  cerrado_por      Int
  created_at       DateTime @default(now())

  usuario  User               @relation(fields: [cerrado_por], references: [id])
  detalles CierreMesDetalle[]
  orders   Order[]

  @@index([fecha_cierre(sort: Desc)])
}

// Detalle por negocio de cada cierre
model CierreMesDetalle {
  id             Int    @id @default(autoincrement())
  cierre_id      Int
  business_id    Int? // puede ser null si el negocio fue eliminado
  nombre_negocio String // snapshot del nombre al momento del cierre
  total_kilos    Float
  total_ventas   Float
  total_pedidos  Int

  cierre CierreMes @relation(fields: [cierre_id], references: [id], onDelete: Cascade)

  @@index([cierre_id])
}

// Registro de contactos por WhatsApp a clientes
model WhatsAppContact {
  id           Int      @id @default(autoincrement())
  business_id  Int
  user_id      Int
  fecha        DateTime @default(now())
  numero_usado String? // qué número de WA se usó (puede quedar vacío)
  genero_venta Boolean  @default(false)
  pedido_kilos Float? // kilos acordados si generó venta
  precio_kg    Float? // precio por kilo si generó venta
  notas        String?
  created_at   DateTime @default(now())

  business Business @relation(fields: [business_id], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [user_id], references: [id])

  @@index([business_id])
  @@index([fecha(sort: Desc)])
}

// Módulo de producción (Eduardo) — una carga = kilos reales que entran a la congeladora
model LoteProduccion {
  id               Int      @id @default(autoincrement())
  kilos            Float // kilos reales cargados a la congeladora
  horas_produccion Int      @default(15) // 15h (meta) ó 24h (máximo)
  fecha            DateTime @default(now())
  notas            String?
  creado_por       Int
  created_at       DateTime @default(now())

  user User @relation(fields: [creado_por], references: [id])

  @@index([fecha(sort: Desc)])
}
