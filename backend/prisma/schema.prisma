generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            Int               @id @default(autoincrement())
  name          String
  email         String            @unique
  password_hash String
  role          String            @default("vendedor") // admin | vendedor | produccion
  created_at    DateTime          @default(now())

  businesses    Business[]
  visit_logs    VisitLog[]
  orders        Order[]
  lotes         LoteProduccion[]
}

model Business {
  id             Int          @id @default(autoincrement())
  nombre         String
  direccion      String
  persona_cargo  String?
  telefono       String
  lat            Float?
  lng            Float?
  estado_visita  String       @default("no_visitado") // no_visitado | visitado_sin_venta | cliente_activo
  creado_por     Int
  created_at     DateTime     @default(now())
  updated_at     DateTime     @updatedAt

  user           User         @relation(fields: [creado_por], references: [id])
  visit_logs     VisitLog[]
  orders         Order[]
}

model VisitLog {
  id          Int       @id @default(autoincrement())
  business_id Int
  user_id     Int
  fecha       DateTime  @default(now())
  tipo        String    // visita_sin_venta | visita_con_venta
  comentario  String?
  created_at  DateTime  @default(now())

  business    Business  @relation(fields: [business_id], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [user_id], references: [id])
}

model Order {
  id              Int       @id @default(autoincrement())
  business_id     Int
  user_id         Int
  fecha           DateTime  @default(now())
  kilos           Float
  precio_kg       Float     @default(400)   // precio por kilo en CLP
  con_iva         Boolean   @default(false) // true = facturado con IVA 19%
  monto_neto      Float?                    // kilos × precio_kg
  monto_total     Float?                    // monto_neto × 1.19 si con_iva, else monto_neto
  estado_pedido   String    @default("pendiente")   // pendiente | entregado
  estado_pago     String    @default("pendiente")   // pendiente | pagado
  estado_factura  String    @default("sin_factura") // sin_factura | facturado
  comentario      String?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  business        Business  @relation(fields: [business_id], references: [id], onDelete: Cascade)
  user            User      @relation(fields: [user_id], references: [id])
}

// Módulo de producción (Eduardo) — una carga = kilos reales que entran a la congeladora
model LoteProduccion {
  id               Int      @id @default(autoincrement())
  kilos            Float    // kilos reales cargados a la congeladora
  horas_produccion Int      @default(15)  // 15h (meta) ó 24h (máximo)
  fecha            DateTime @default(now())
  notas            String?
  creado_por       Int
  created_at       DateTime @default(now())

  user             User     @relation(fields: [creado_por], references: [id])
}
